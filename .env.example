# -----------------------------------------------------------------------------
# LofiCraft Panel - environment template
#
# THIS FILE IS PUBLIC. Placeholders only. Copy it to .env (gitignored) and put
# your real values there. Never commit .env.
# -----------------------------------------------------------------------------

# -- Plugins folder -----------------------------------------------------------
# Path to your Minecraft server's plugins folder on the host machine.
# Windows example: PLUGINS_PATH=C:/servers/minecraft/plugins
# Linux example:   PLUGINS_PATH=/opt/minecraft/plugins
PLUGINS_PATH=/path/to/your/minecraft/plugins

# UID and GID the container runs as. Must own PLUGINS_PATH so config saves
# work without root. Find them with: stat -c '%u %g' /path/to/your/plugins
PUID=1000
PGID=1000

# -- RCON ---------------------------------------------------------------------
# Must match server.properties (enable-rcon=true, rcon.port, rcon.password).
# host.docker.internal = the machine Docker runs on.
RCON_HOST=host.docker.internal
RCON_PORT=25575
RCON_PASSWORD=your_rcon_password_here

# Command sent by the Reload button. %plugin% is replaced with the plugin name.
# Default reloads the whole server; with PluginMan or similar you can use:
#   RCON_RELOAD_COMMAND=plugman reload %plugin%
RCON_RELOAD_COMMAND=reload confirm

# -- Network ------------------------------------------------------------------
# The panel has no login of its own: keep it private.
# BIND_ADDRESS: which address the port listens on. 127.0.0.1 = this machine
# only (recommended). Use your LAN IP only on a trusted network.
BIND_ADDRESS=127.0.0.1
PORT=3000

# Host names the panel answers to, comma-separated. Add your SWAG subdomain
# (for example loficraft.example.com) when running behind SWAG.
ALLOWED_HOSTS=localhost,127.0.0.1

# Only for docker-compose.swag.example.yml: the name of SWAG's Docker network.
# SWAG_NETWORK=your_swag_network

# Container name (also used as the upstream name in the SWAG conf sample)
CONTAINER_NAME=loficraft-panel
