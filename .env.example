# Path to your Minecraft server's plugins folder on the host machine
# Windows example: PLUGINS_PATH=C:/servers/minecraft/plugins
# Linux example:   PLUGINS_PATH=/opt/minecraft/plugins
PLUGINS_PATH=/path/to/your/minecraft/plugins

# RCON configuration — must match your server.properties
# enable-rcon=true
# rcon.port=25575
# rcon.password=your_password
RCON_PORT=25575
RCON_PASSWORD=your_rcon_password_here

# Optional: reload command sent via RCON after saving a config
# %plugin% is replaced with the plugin name (requires PluginMan or similar)
# Default reloads the entire server — swap for per-plugin reload if you have PluginMan:
#   RCON_RELOAD_COMMAND=plugman reload %plugin%
RCON_RELOAD_COMMAND=reload confirm

# Web panel port (default: 3000)
PORT=3000
